# AWS Configuration
# Uses the default AWS credential chain: profile, env vars, or IAM role.
# Set AWS_REGION to the region where your AgentCore agents are deployed.
AWS_REGION=us-east-1

# Optional: specify a profile name if not using the default profile
# AWS_PROFILE=default

# Harness Execution Role (required for Deploy button on Build page)
# This IAM role gets assigned to newly created harness agents.
# The role must have bedrock:InvokeModel permissions.
# HARNESS_EXECUTION_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/YourHarnessExecutionRole

# Builder Agent (optional — set after running deploy/setup-builder-agent.mjs)
# When set, the Build page uses a real AgentCore harness with tools + memory.
# Without it, falls back to direct Converse API (no tools, no memory).
# BUILDER_AGENT_ID=agentis_builder-xxxxxxxxxx

# Routing Demo (optional — set after running deploy/setup-routing-agents.mjs)
# These override the hardcoded defaults in src/app/routing/page.tsx
# DESIGN_AGENT_ID=routing_designer_v2-xxxxxxxxxx
# DEV_AGENT_ID=routing_developer_v2-xxxxxxxxxx

# Workflow Orchestration (required for Team Workflow feature)
# S3 bucket for workflow artifacts (agent outputs, design docs, code)
# ARTIFACT_BUCKET=agentcore-artifacts-ACCOUNT_ID-us-east-1

# ARN prefix for AgentCore harnesses (used by routing page UI)
# NEXT_PUBLIC_AGENTCORE_ARN_PREFIX=arn:aws:bedrock-agentcore:us-east-1:ACCOUNT_ID:harness

# GitHub MCP integration (required for workflow agents to push code/create PRs)
# Agents connect to GitHub's hosted MCP server via this token
# GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MCP Servers (JSON array — override GITHUB_PAT for custom MCP setups)
# MCP_SERVERS=[{"url":"https://api.githubcopilot.com/mcp/","headers":{"Authorization":"Bearer ghp_xxx"}}]

# Model selection (optional — enables additional model providers)
# OPENAI_API_KEY_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:openai-api-key

# ─── Orchestration Mode (DL-005) ────────────────────────────────────────────
# "in-process" = Next.js engine drives orchestration inline (default, no extra infra)
# "lambda" = DynamoDB Streams + Lambda orchestrator (target for production/Jira swap)
# ORCHESTRATION_MODE=in-process

# Required for lambda mode:
# WORKFLOWS_TABLE=agentis-workflows
# JIRA_TABLE_NAME=agentis-tickets
# TICKET_PROVIDER=dynamodb

# Webhook security (used by both modes)
# WEBHOOK_SECRET=your-secret-here

# ─── Agent Fleet Deployment ─────────────────────────────────────────────────
# These are used by deploy/runtime-agent/deploy-one.sh and deploy-fleet.sh
# AGENTCORE_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/YourAgentCoreExecutionRole
# GATEWAY_ARN=arn:aws:bedrock-agentcore:us-east-1:ACCOUNT_ID:gateway/your-gateway-id
# ARTIFACT_BUCKET=agentcore-artifacts-ACCOUNT_ID-us-east-1

# Jira integration (required for real Jira mode)
# JIRA_SITE_URL=your-site.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=your-jira-api-token
# JIRA_PROJECT_KEY=TEAM
